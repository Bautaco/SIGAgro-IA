# Servicio de IA de SIGAgro (ver README.md)
MODELO_ID=wambugu71/crop_leaf_diseases_vit
MODELO_REVISION=7d5b32bcd6f83a2f57e7e0346358fad276296877
UMBRAL_CONFIANZA=0.60
MARGEN_MINIMO=0.15
# Token compartido con el backend (AI_SERVICE_TOKEN). Vacío = sin autenticación (solo desarrollo)
TOKEN_SERVICIO=

# --- Análisis en línea (Claude, de Anthropic) para cultivos que el modelo local no cubre ---
# Se usa solo si hay clave: cultivos no cubiertos (soja, girasol, maní...) y resultados locales no concluyentes.
# Sin clave o sin internet, el servicio sigue funcionando solo con el modelo local.
# La clave se crea en https://console.anthropic.com (requiere crédito). NUNCA subirla a GitHub.
ANTHROPIC_API_KEY=
# auto (si hay clave) | si | no
EN_LINEA=auto
MODELO_EN_LINEA=claude-opus-5-5
ESFUERZO_EN_LINEA=medium
TIMEOUT_EN_LINEA=45
UMBRAL_EN_LINEA=0.60
